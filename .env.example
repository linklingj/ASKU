# docker-compose 용 설정. 이 파일을 .env 로 복사해 실제 값을 채운다 (git 에 올리지 않음).
# 상세: docs/02_FEATURES/deployment.md

# Postgres 비밀번호 (DB 컨테이너 + DATABASE_URL 에 함께 쓰임)
POSTGRES_PASSWORD=change-me

# 답변 생성·추출 LLM 제공자 (기본 openai). gemini 로 되돌리려면 아래 주석 해제
# LLM_PROVIDER=openai

# OpenAI(GPT) — 기본 제공자 (임베딩은 로컬 bge-m3 라 키 불필요)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini — LLM_PROVIDER=gemini 일 때만 필요
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# 템플릿에 없는 학교의 수집 규격을 LLM 으로 생성할지 (기본 꺼짐, 호출당 ~4만 토큰)
# SPEC_AUTOGEN=1
