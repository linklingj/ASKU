# 이 파일을 backend/.env 로 복사해 각자 값을 채운다. .env 는 커밋되지 않는다.
# 개발용 스크립트만 이 파일을 읽는다(app/settings.py). 운영(도커)에서는 compose 가
# 프로젝트 루트의 .env 를 읽어 컨테이너에 환경변수로 주입한다.

# PostgreSQL + pgvector 접속 문자열. 실제 비밀번호는 .env에만 보관한다.
DATABASE_URL=postgresql+psycopg://asku:asku@localhost:5432/asku

# Gemini — 답변 생성·엔티티 추출·수집 규격 자동 생성에 쓴다.
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
